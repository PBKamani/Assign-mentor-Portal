# Assignmentor Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Firebase Service Account Credentials
# Option 1: File path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option 2: Environment variables (ideal for Render/Railway/Cloud Run)
FIREBASE_PROJECT_ID=assignmentor-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@assignmentor-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=assignmentor-demo.appspot.com

# Mock/Demo Mode (Allows development without active cloud credentials)
USE_MOCK_FIREBASE=false
