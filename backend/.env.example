# Assignmentor Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
# Development: http://localhost:5173
# Production (GitHub Pages): https://<your-github-username>.github.io
FRONTEND_URL=http://localhost:5173

# Firebase Service Account Credentials (NEVER COMMIT ACTUAL SECRETS)
# Option 1: File path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option 2: Environment variables (ideal for Render/Railway/Cloud Run)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
